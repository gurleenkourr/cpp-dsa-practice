class Solution {
public:
    int compress(vector<char>& chars) {
        int i=0;
        int ansindex=0;
        int n=chars.size();

        while(i<n){
            int j=i+1;
            while(j<n && chars[i]==chars[j]){
                j++;
            }
            //yaha kab aaogai jb 2 case honge
            //ya toh vector  poora traverse krdia
            //ya phr new/diff charcter dikh gea

            //oldechar store krlo
            chars[ansindex++]=chars[i];
            int count=j-i;
            if(count>1){
                //converting counting into single digit and saving ans
                string cnt =to_string(count);
                for(char ch: cnt){
                    chars[ansindex++]=ch;
                }
            }
            //moving to new diff character
            i=j;
        }
        return ansindex;
    }
};
