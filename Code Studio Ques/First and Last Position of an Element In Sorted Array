
int firstoccurence(vector<int>& arr,int n, int key){
    int start=0;
    int end = n -1;
    int ans=-1;

    int mid=start + (end-start)/2;
    while(start<=end){
        if(arr[mid]==key){
            ans=mid;
            end=mid-1;
        }
        else if(arr[mid]<key){//right me jana
            start=mid+1;
        }
        else if(arr[mid]>key){//left me jana
            end=mid-1;
        }

        mid=start + (end-start)/2;

    }
    return ans;
}

int lastoccurence(vector<int>& arr,int n, int key){
    int start=0;
    int end = n -1;
    int ans=-1;

    int mid=start + (end-start)/2;
    while(start<=end){
        if(arr[mid]==key){
            ans=mid;
            start=mid+1;
        }
        else if(arr[mid]<key){//right me jana
            start=mid+1;
        }
        else if(arr[mid]>key){//left me jana
            end=mid-1;
        }

        mid=start + (end-start)/2;

    }
    return ans;
}
pair<int, int> firstAndLastPosition(vector<int>& arr, int n, int k)
{
    pair<int,int>p;
    p.first =firstoccurence(arr,n,k);
    p.second =lastoccurence(arr,n,k);

    return p;
}
