#include <bits/stdc++.h> 
char tolowercase(char ch){
    if(ch>='a' && ch<='z'){
        return ch;
    }
    else{
        char temp=ch - 'A' +'a';
        return temp;
    }
}
bool checkPalindrome(string s)
{
    int st = 0;
    int e = s.length() - 1;

    while (st < e) {

        if (!isalnum(s[st])) {
            st++;
        }
        else if (!isalnum(s[e])) {
            e--;
        }
        else {
            if (tolower(s[st]) != tolower(s[e])) {
                return false;
            }

            st++;
            e--;
        }
    }

    return true;

}
